}
userdb sql {
    query = SELECT u.home_path AS home, u.uid AS uid, u.gid AS gid FROM mail_users u JOIN domains d ON d.id = u.domain_id WHERE u.email = lower('%{user}') AND u.enabled = 1 AND d.enabled = 1
    iterate_query = SELECT u.email AS user FROM mail_users u JOIN domains d ON d.id = u.domain_id WHERE u.enabled = 1 AND d.enabled = 1
}

mail_driver = maildir
mail_path = ~/Mail
mail_inbox_path = ~/Mail/Inbox
mailbox_list_layout = fs
namespace inbox {
    inbox = yes
    mailbox Drafts {
        special_use = \\Drafts
        auto = subscribe
    }
    mailbox Junk {
        special_use = \\Junk
        auto = subscribe
        autoexpunge = 30d
    }
    mailbox Sent {
        special_use = \\Sent
        auto = subscribe
    }
    mailbox Trash {
        special_use = \\Trash
    }

#!/bin/sh

set -eu
umask 0027

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${EMAILWIZ_APP_DIR:-}" ]; then
	:
elif [ -d "$script_dir/app/management" ]; then
	EMAILWIZ_APP_DIR=$script_dir/app
elif [ -d "$script_dir/../lib/emailwiz/management" ]; then
	EMAILWIZ_APP_DIR=$(CDPATH='' cd -- "$script_dir/../lib/emailwiz" && pwd)
else
	EMAILWIZ_APP_DIR=/usr/local/lib/emailwiz
fi

[ -f "$EMAILWIZ_APP_DIR/management/main.sh" ] || {
	printf 'ERROR: Emailwiz management modules were not found in %s.\n' "$EMAILWIZ_APP_DIR" >&2
	exit 1
}
export EMAILWIZ_APP_DIR

# shellcheck source=app/management/main.sh
. "$EMAILWIZ_APP_DIR/management/main.sh"
emailwiz_management_main "$@"

	cat <<EOF
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0
# Generated by emailwizctl for Dovecot $DOVECOT_VERSION. Do not edit manually.

ssl = required
ssl_min_protocol = TLSv1.2
ssl_server_prefer_ciphers = client

service auth {
    unix_listener /var/spool/postfix/private/auth {
        mode = 0660
        user = postfix
        group = postfix
    }
}
service lmtp {
    unix_listener /var/spool/postfix/private/dovecot-lmtp {
        mode = 0600
        user = postfix
        group = postfix
    }
}

protocol lmtp {
    postmaster_address = postmaster@%{user | domain}
    mail_plugins {
        sieve = yes
    }
}
protocol pop3 {
    pop3_no_flag_updates = yes
}

sieve_script personal {
    path = ~/.dovecot.sieve
}
sieve_script default {
    type = default
    name = default
    path = $SIEVE_DIR/default.sieve

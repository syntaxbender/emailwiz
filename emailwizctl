render_dovecot_sql_23() {
	cat <<EOF
# Generated by emailwizctl for Dovecot 2.3.
driver = sqlite
connect = $DB_PATH
password_query = SELECT u.email AS user, u.password_hash AS password FROM mail_users u JOIN domains d ON d.id = u.domain_id WHERE u.email = lower('%u') AND u.enabled = 1 AND d.enabled = 1
user_query = SELECT u.home_path AS home, u.uid AS uid, u.gid AS gid FROM mail_users u JOIN domains d ON d.id = u.domain_id WHERE u.email = lower('%u') AND u.enabled = 1 AND d.enabled = 1
iterate_query = SELECT u.email AS user FROM mail_users u JOIN domains d ON d.id = u.domain_id WHERE u.enabled = 1 AND d.enabled = 1
EOF
}

